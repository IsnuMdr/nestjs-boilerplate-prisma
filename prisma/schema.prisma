// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String   @id @default(uuid())
  name         String
  address      String?
  contact_info String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  departments Department[]
  assets      Asset[]
  users       User[]
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Foreign Keys
  company_id String

  // Relations
  company   Company    @relation(fields: [company_id], references: [id])
  divisions Division[]
  assets    Asset[]
}

model Division {
  id          String   @id @default(uuid())
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Foreign Keys
  department_id String

  // Relations
  department Department @relation(fields: [department_id], references: [id])
  users      User[]
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  role       UserRole
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  last_login DateTime?

  // Foreign Keys
  division_id String?
  company_id  String?

  // Relations
  division Division? @relation(fields: [division_id], references: [id])
  company  Company?  @relation(fields: [company_id], references: [id])

  // Asset Relations
  current_assets  Asset[] @relation("AssetCurrentUser")
  previous_assets Asset[] @relation("AssetPreviousUser")
  updated_assets  Asset[] @relation("AssetUpdatedBy")

  // Handover Document Relations
  created_handovers  HandoverDocument[] @relation("HandoverCreatedBy")
  received_handovers HandoverDocument[] @relation("HandoverFromUser")
  handed_handovers   HandoverDocument[] @relation("HandoverToUser")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  assets Asset[]
}

model Asset {
  id              String         @id @default(uuid())
  name            String
  code            String         @unique
  serial_number   String?
  condition       AssetCondition
  accessories     String?
  notes           String?
  outlook_account String?
  image_url       String?
  purchase_date   DateTime?
  purchase_price  Decimal?
  warranty_expiry DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  // Foreign Keys
  current_user_id  String?
  previous_user_id String?
  department_id    String
  company_id       String
  category_id      String
  updated_by       String

  // Relations
  current_user    User?      @relation("AssetCurrentUser", fields: [current_user_id], references: [id])
  previous_user   User?      @relation("AssetPreviousUser", fields: [previous_user_id], references: [id])
  department      Department @relation(fields: [department_id], references: [id])
  company         Company    @relation(fields: [company_id], references: [id])
  category        Category   @relation(fields: [category_id], references: [id])
  updated_by_user User       @relation("AssetUpdatedBy", fields: [updated_by], references: [id])

  // Handover Documents
  handover_documents HandoverDocument[]
}

model HandoverDocument {
  id                String         @id @default(uuid())
  document_file_url String
  handover_date     DateTime
  notes             String?
  status            HandoverStatus
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  // Foreign Keys
  asset_id     String
  from_user_id String?
  to_user_id   String
  created_by   String

  // Relations
  asset           Asset @relation(fields: [asset_id], references: [id])
  from_user       User? @relation("HandoverFromUser", fields: [from_user_id], references: [id])
  to_user         User  @relation("HandoverToUser", fields: [to_user_id], references: [id])
  created_by_user User  @relation("HandoverCreatedBy", fields: [created_by], references: [id])
}

enum UserRole {
  admin
  manager
}

enum AssetCondition {
  active
  damaged
  lost
  borrowed
}

enum HandoverStatus {
  pending
  completed
  cancelled
}
